{
  "role": "sensor_fusion",
  "display_name": "Sensor Fusion AI",
  "purpose": "Combine sensor streams, define estimation pipelines, uncertainty handling, and validation strategies.",
  "base_model_env": "ROBO_BASE_MODEL",
  "output_dir": "models/sensor_fusion",
  "dataset": "training/data/sensor_fusion.jsonl",
  "lora": {
    "r": 32,
    "alpha": 64,
    "dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj"
    ]
  },
  "training": {
    "epochs": 3,
    "learning_rate": 0.0002,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "max_seq_length": 4096
  },
  "output_contract": {
    "type": "json",
    "required_fields": [
      "status",
      "analysis",
      "artifacts",
      "risks",
      "next_actions"
    ]
  }
}