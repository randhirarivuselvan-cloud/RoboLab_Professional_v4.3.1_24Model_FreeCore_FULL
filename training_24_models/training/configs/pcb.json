{
  "role": "pcb",
  "display_name": "PCB AI",
  "purpose": "Plan PCB architecture, interfaces, placement/routing constraints, power integrity, and manufacturing checks.",
  "base_model_env": "ROBO_BASE_MODEL",
  "output_dir": "models/pcb",
  "dataset": "training/data/pcb.jsonl",
  "lora": {
    "r": 32,
    "alpha": 64,
    "dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj"
    ]
  },
  "training": {
    "epochs": 3,
    "learning_rate": 0.0002,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "max_seq_length": 4096
  },
  "output_contract": {
    "type": "json",
    "required_fields": [
      "status",
      "analysis",
      "artifacts",
      "risks",
      "next_actions"
    ]
  }
}